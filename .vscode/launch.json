{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug zod-ngine2",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/zod-ngine2",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "windows": {
                "program": "${workspaceFolder}/build-debug/zod-ngine2.exe",
                "miDebuggerPath": "gdb.exe"
            }
        },
        {
            "name": "Debug Unit Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/tests/${input:testName}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "windows": {
                "program": "${workspaceFolder}/build-debug/tests/${input:testName}.exe",
                "miDebuggerPath": "gdb.exe"
            }
        }
    ],
    "inputs": [
        {
            "id": "testName",
            "type": "pickString",
            "description": "Which test executable to debug",
            "options": ["test_defer", "test_mem", "test_mem_area", "test_zarray", "test_zlogger"]
        }
    ]
}
